{
  "version": 1,
  "title": "Connected fleet and IoT platform",
  "description": "Vehicles and equipment in the field send telemetry through regional edge brokers to a cloud ingestion tier. Streams are validated, enriched and stored as time series; digital twins, alerts and analytics run on top, and over-the-air updates flow back to the devices in staged rollouts. Devices are authenticated by certificates and every command is authorised and recorded.",
  "lenses": [
    {
      "id": "security"
    },
    {
      "id": "cost"
    },
    {
      "id": "risks"
    },
    {
      "id": "planes"
    }
  ],
  "nodes": [
