      "id": "vehicles",
      "label": "Vehicles",
      "sub": "Telematics units",
      "icons": [
        "server"
      ],
      "detail": {
        "role": "Connected vehicles that report position, health and usage.",
        "why": "The fleet is the product."
      },
      "layer": "field",
      "at": {
        "col": 6,
        "row": 1
      },
      "lenses": {
        "risks": {
          "badge": "Intermittent links",
          "text": "Vehicles lose coverage. Units buffer readings and send them when the link returns.",
          "level": "warn"
        }
      }
    },
    {
