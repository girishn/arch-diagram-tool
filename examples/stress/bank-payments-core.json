{
  "version": 1,
  "title": "Bank: digital channels, payments hub and core banking",
  "description": "Customers and corporate clients reach the bank through digital channels and open-banking APIs. A payments hub routes each payment to the right scheme after fraud and sanctions checks, and posts it to the core ledger. A lakehouse feeds regulatory reporting and risk. Two data centres and a cloud region keep it running, and everything is segmented, logged and held to least privilege.",
  "lenses": [
    {
      "id": "security"
    },
    {
      "id": "cost"
    },
    {
      "id": "risks"
    },
    {
      "id": "planes"
    }
  ],
