      "at": {
        "col": 2,
        "row": 8
      },
      "plane": "control"
    },
    {
      "id": "iac",
      "label": "Infrastructure as code",
      "sub": "Terraform",
      "icons": [
        "terraform"
      ],
      "detail": {
        "role": "Creates networks, clusters and databases.",
