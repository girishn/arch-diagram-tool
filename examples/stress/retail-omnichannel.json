      "layer": "ops",
      "at": {
        "col": 5,
        "row": 8
      },
      "plane": "control"
    },
    {
      "id": "siem",
      "label": "Security monitoring",
      "sub": "SIEM",
      "icons": [
        "audit"
      ],
      "detail": {
        "role": "Correlates security events and raises alerts.",
