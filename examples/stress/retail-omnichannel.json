      "label": "Secrets and keys",
      "sub": "Vault and KMS",
      "icons": [
        "kms"
      ],
      "detail": {
        "role": "Stores secrets and encryption keys.",
        "why": "No secret lives in code or images."
      },
      "layer": "ops",
      "at": {
        "col": 4,
        "row": 8
      },
      "plane": "control",
      "lenses": {
        "security": {
          "badge": "Rotated",
          "text": "Secrets rotate automatically and are issued per workload.",
          "level": "good"
        }
      }
    },
