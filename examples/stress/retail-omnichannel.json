      },
      "layer": "ext",
      "at": {
        "col": 1,
        "row": 6
      }
    },
    {
      "id": "tax",
      "label": "Tax service",
      "sub": "Rates and filing",
      "icons": [
        "internet"
      ],
      "detail": {
        "role": "Calculates tax per country and state.",
        "why": "Rules change often and are someone else's job."
      },
      "layer": "ext",
      "at": {
        "col": 3,
        "row": 6
      }
    },
    {
      "id": "repo",
      "label": "Source repositories",
      "sub": "Git",
      "icons": [
        "git"
      ],
      "detail": {
        "role": "Code and configuration for every service.",
        "why": "Every change is reviewed and traceable."
      },
      "layer": "ops",
      "at": {
        "col": 0,
        "row": 7
      },
      "plane": "control"
    },
    {
      "id": "ci",
      "label": "Build and test",
      "sub": "CI pipelines",
      "icons": [
        "github-actions"
      ],
      "detail": {
        "role": "Builds, tests and scans each change.",
        "why": "Nothing reaches production unchecked."
      },
      "layer": "ops",
      "at": {
        "col": 0,
        "row": 8
      },
      "plane": "control",
      "lenses": {
        "security": {
          "badge": "Supply chain scanned",
          "text": "Dependencies and images are scanned and signed in the pipeline.",
