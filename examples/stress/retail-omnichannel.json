{
  "version": 1,
  "title": "Global omnichannel retail platform",
  "description": "Shoppers on web, mobile and in store reach one set of APIs at the edge. Microservices on Kubernetes in two regions handle catalogue, basket, orders and payments, and publish events that drive search, recommendations, fulfilment and analytics. Everything ships through one delivery pipeline and is watched from one place.",
  "lenses": [
    {
      "id": "security"
    },
    {
      "id": "cost"
    },
    {
      "id": "risks"
    },
    {
      "id": "planes"
    }
  ],
  "nodes": [
    {
      "id": "shoppers-web",
      "label": "Web shoppers",
      "sub": "Browsers",
      "icons": [
        "browser"
      ],
      "detail": {
        "role": "People browsing and buying on the website.",
        "why": "The largest source of traffic and revenue."
      },
      "layer": "edge",
      "at": {
        "col": 2,
        "row": 0
      }
    },
    {
      "id": "shoppers-app",
      "label": "Mobile shoppers",
      "sub": "iOS and Android",
      "icons": [
        "users"
      ],
      "detail": {
        "role": "People using the native apps.",
        "why": "Highest conversion; the app also carries loyalty and push."
      },
      "layer": "edge",
      "at": {
        "col": 10,
        "row": 0
      }
    },
    {
      "id": "stores",
      "label": "Store systems",
      "sub": "POS and kiosks",
      "icons": [
        "server"
      ],
      "detail": {
        "role": "Tills, kiosks and handhelds in physical stores.",
        "why": "Stores sell and fulfil from the same stock as online."
      },
      "layer": "edge",
      "at": {
        "col": 6,
        "row": 0
      },
      "lenses": {
        "risks": {
          "badge": "Flaky links",
          "text": "Store networks drop. Tills queue sales locally and sync when the link returns.",
          "level": "warn"
        }
      }
    },
    {
      "id": "dns",
      "label": "DNS",
      "sub": "Latency and health routing",
      "icons": [
        "route53"
      ],
      "detail": {
        "role": "Sends each shopper to the nearest healthy region.",
        "why": "A regional failure becomes a routing change, not an outage.",
        "tag": "Route 53"
      },
      "layer": "edge",
      "at": {
        "col": 1,
        "row": 0
      }
    },
    {
      "id": "cdn",
      "label": "CDN",
      "sub": "Images, pages, static assets",
      "icons": [
        "cloudfront"
      ],
      "detail": {
        "role": "Serves images, scripts and cached pages from a point near the shopper.",
        "why": "Most page weight never reaches the platform, which keeps peak sales affordable."
      },
      "layer": "edge",
      "at": {
        "col": 3,
        "row": 0
      },
      "lenses": {
        "cost": {
          "badge": "Offloads traffic",
          "text": "A cache hit costs a fraction of an origin request. A peak sale is mostly CDN traffic.",
          "level": "info"
        }
      }
    },
    {
      "id": "waf",
      "label": "Web firewall",
      "sub": "WAF and bot control",
      "icons": [
        "firewall"
      ],
      "detail": {
        "role": "Blocks injection attempts, scrapers and credential-stuffing bots before they reach any service.",
        "why": "Abuse is stopped at the edge, so it never competes with real shoppers for capacity."
      },
      "layer": "edge",
      "at": {
        "col": 7,
        "row": 0
      },
      "lenses": {
        "security": {
          "badge": "Bots filtered",
          "text": "Rate limits, bot scoring and managed rules apply to every request.",
          "level": "good"
        }
      }
    },
    {
      "id": "gw",
      "label": "API gateway",
      "sub": "Public APIs",
      "icons": [
        "api-gateway"
      ],
      "detail": {
        "role": "The single front door: routes, throttles and authenticates calls.",
        "why": "Teams change internals freely while the public contract stays stable."
      },
      "layer": "exp",
      "at": {
        "col": 7,
        "row": 1
      },
      "plane": "data",
      "lenses": {
        "security": {
          "badge": "One front door",
          "text": "Every public call is authenticated and throttled here before reaching a service.",
          "level": "good"
        }
      }
    },
    {
      "id": "bff-web",
      "label": "Web backend",
      "sub": "BFF",
      "icons": [
        "server"
      ],
      "detail": {
        "role": "Combines several services into the exact shapes the website needs.",
        "why": "The site makes one call, not twelve."
      },
      "layer": "exp",
      "at": {
        "col": 1,
        "row": 1
      },
      "plane": "data"
    },
    {
      "id": "bff-app",
      "label": "Mobile backend",
      "sub": "BFF",
      "icons": [
        "server"
      ],
      "detail": {
        "role": "Does the same for the apps, with smaller payloads and offline-friendly responses.",
        "why": "Phones get what they need on poor networks."
      },
      "layer": "exp",
      "at": {
        "col": 9,
        "row": 1
      },
      "plane": "data"
    },
    {
      "id": "bff-store",
      "label": "Store backend",
      "sub": "BFF",
      "icons": [
        "server"
      ],
      "detail": {
        "role": "Serves tills and kiosks, with local fallbacks.",
        "why": "A store can keep selling when the head office is slow."
      },
      "layer": "exp",
      "at": {
        "col": 4,
        "row": 1
      },
      "plane": "data"
    },
    {
      "id": "idp",
      "label": "Customer identity",
      "sub": "Sign-in and profiles",
      "icons": [
        "cognito"
      ],
      "detail": {
        "role": "Accounts, social sign-in, multi-factor and consent records.",
        "why": "One login across web, app and store; consent is stored once."
      },
      "layer": "exp",
      "at": {
        "col": 2,
        "row": 1
      },
      "plane": "control",
      "lenses": {
        "security": {
          "badge": "Consent recorded",
          "text": "Marketing and data consent are captured per account and checked before any use.",
          "level": "good"
        }
      }
    },
    {
      "id": "flags",
      "label": "Feature flags",
      "sub": "Gradual rollout",
      "icons": [
        "settings"
      ],
      "detail": {
        "role": "Turns features on for a share of shoppers and off instantly.",
        "why": "A bad release is switched off in seconds, with no redeploy."
      },
      "layer": "exp",
      "at": {
        "col": 10,
        "row": 1
      },
      "plane": "control"
    },
    {
      "id": "catalog",
      "label": "Catalogue",
      "sub": "Products and prices",
      "icons": [
        "container"
      ],
      "detail": {
        "role": "Owns product data, pricing and promotions.",
        "why": "One truth for what is sold and for how much."
      },
      "layer": "svc",
      "at": {
        "col": 0,
        "row": 2
      },
      "plane": "data",
      "scale": {
        "min": 6,
        "max": 40,
        "unit": "pods",
        "trigger": "CPU > 60%"
      }
    },
    {
      "id": "inventory",
      "label": "Inventory",
      "sub": "Stock by location",
      "icons": [
        "container"
      ],
      "detail": {
        "role": "Tracks stock in warehouses and stores and reserves it for orders.",
        "why": "Shoppers are never sold what is not there.",
        "tradeoff": "Reservations must expire, or abandoned baskets lock stock."
      },
      "layer": "svc",
      "at": {
        "col": 3,
        "row": 3
      },
      "plane": "data"
    },
    {
      "id": "basket",
      "label": "Basket",
      "sub": "Carts and checkout",
      "icons": [
        "container"
      ],
      "detail": {
        "role": "Holds the cart, applies offers and prices the order.",
        "why": "Checkout stays fast because it holds only what it needs."
      },
      "layer": "svc",
      "at": {
        "col": 2,
        "row": 2
      },
      "plane": "data",
      "scale": {
        "min": 8,
        "max": 60,
        "unit": "pods",
        "trigger": "requests per second"
      }
    },
    {
      "id": "orders",
      "label": "Orders",
      "sub": "Order lifecycle",
      "icons": [
        "container"
      ],
      "detail": {
        "role": "Creates and tracks orders from payment to delivery.",
        "why": "A single record of what happened to every order."
      },
      "layer": "svc",
      "at": {
        "col": 4,
        "row": 3
      },
      "plane": "data"
    },
    {
      "id": "payments",
      "label": "Payments",
      "sub": "Authorise and capture",
      "icons": [
        "container"
      ],
      "detail": {
        "role": "Talks to the payment provider, handles retries and refunds.",
        "why": "Card data never touches the rest of the platform."
      },
      "layer": "svc",
      "at": {
        "col": 1,
        "row": 3
      },
      "plane": "data",
      "lenses": {
        "security": {
          "badge": "Out of PCI scope",
          "text": "Only tokens are stored. The card number goes straight to the provider.",
          "level": "good"
        },
        "risks": {
          "badge": "Provider dependency",
          "text": "If the provider is down, checkout fails. A second provider is configured for failover.",
          "level": "warn"
        }
      }
    },
    {
      "id": "fulfil",
      "label": "Fulfilment",
      "sub": "Pick, pack, ship",
      "icons": [
        "container"
      ],
      "detail": {
        "role": "Plans picking and shipping and books carriers.",
        "why": "Orders leave the cheapest, closest location."
      },
      "layer": "svc",
      "at": {
        "col": 5,
        "row": 3
      },
      "plane": "data"
    },
    {
      "id": "loyalty",
      "label": "Loyalty",
      "sub": "Points and offers",
      "icons": [
        "container"
      ],
      "detail": {
        "role": "Earns and spends points and issues personal offers.",
        "why": "Repeat purchases are rewarded the same way on every channel."
      },
      "layer": "svc",
      "at": {
        "col": 2,
        "row": 3
      },
      "plane": "data"
    },
    {
      "id": "search",
      "label": "Search service",
      "sub": "Query and ranking",
      "icons": [
        "container"
      ],
      "detail": {
        "role": "Answers search and browse queries.",
        "why": "Finding the product is the first step of every sale."
      },
      "layer": "svc",
      "at": {
        "col": 5,
        "row": 2
      },
      "plane": "data"
    },
    {
      "id": "recs",
      "label": "Recommendations",
      "sub": "Personalised picks",
      "icons": [
        "model"
      ],
      "detail": {
        "role": "Suggests products per shopper from behaviour and similar baskets.",
        "why": "Raises basket size with no manual merchandising."
      },
      "layer": "svc",
      "at": {
        "col": 9,
        "row": 3
      },
      "plane": "data",
      "lenses": {
        "cost": {
          "badge": "Inference cost",
          "text": "Models run on a small GPU pool. Cost follows traffic.",
          "level": "info"
        }
      }
    },
    {
      "id": "pricing-ml",
      "label": "Dynamic pricing",
      "sub": "Model",
      "icons": [
        "model"
      ],
      "detail": {
        "role": "Suggests price changes from demand, stock and competitor prices.",
        "why": "Margin improves on slow lines and stock sells through."
      },
      "layer": "svc",
      "at": {
        "col": 7,
        "row": 2
      },
      "plane": "data",
      "lenses": {
        "risks": {
          "badge": "Needs a guard",
          "text": "Price changes are capped and reviewed. Unbounded pricing models damage trust.",
          "level": "warn"
        }
      }
    },
    {
      "id": "fraud",
      "label": "Fraud scoring",
      "sub": "Real time",
      "icons": [
        "model"
      ],
      "detail": {
        "role": "Scores every order for fraud risk before payment is captured.",
        "why": "Loss is stopped before money moves."
      },
      "layer": "svc",
      "at": {
        "col": 6,
        "row": 3
      },
      "plane": "data",
      "lenses": {
        "security": {
          "badge": "Decision logged",
          "text": "Every score and decision is stored with its inputs for dispute handling.",
          "level": "good"
        }
      }
    },
    {
      "id": "notify",
      "label": "Notifications",
      "sub": "Email, SMS, push",
      "icons": [
        "function"
      ],
      "detail": {
        "role": "Sends order, delivery and offer messages.",
        "why": "Shoppers hear about their order without asking."
      },
      "layer": "svc",
      "at": {
        "col": 7,
        "row": 3
      },
      "plane": "data"
    },
    {
      "id": "ctrl-plane",
      "label": "Platform controller",
      "sub": "Config and quotas",
      "icons": [
        "compute"
      ],
      "detail": {
        "role": "Applies per-team quotas, limits and routing rules.",
        "why": "Teams cannot starve each other."
      },
      "layer": "svc",
      "at": {
        "col": 8,
        "row": 2
      },
      "plane": "control"
    },
    {
      "id": "bus",
      "label": "Event backbone",
      "sub": "Kafka, multi-region",
      "icons": [
        "kafka"
      ],
      "detail": {
        "role": "Carries every business event: order placed, stock changed, payment captured.",
        "why": "Services stay independent and new consumers need no change to producers."
      },
      "layer": "data",
      "at": {
        "col": 4,
        "row": 5
      },
      "plane": "data",
      "lenses": {
        "security": {
          "badge": "Authorised per topic",
          "text": "Each service can publish and read only its own topics.",
          "level": "good"
        },
        "cost": {
          "badge": "Throughput priced",
          "text": "Cost follows throughput and retention.",
          "level": "info"
        }
      }
    },
    {
      "id": "catalog-db",
      "label": "Catalogue store",
      "sub": "Document database",
      "icons": [
        "dynamodb"
      ],
      "detail": {
        "role": "Product and price documents.",
        "why": "Reads scale with the CDN-fronted catalogue."
      },
      "layer": "data",
      "at": {
        "col": 0,
        "row": 4
      },
      "plane": "data"
    },
    {
      "id": "inv-db",
      "label": "Inventory store",
      "sub": "Relational, replicated",
      "icons": [
        "database"
      ],
      "detail": {
        "role": "Stock levels with strong consistency.",
        "why": "Reservations must never oversell."
      },
      "layer": "data",
      "at": {
        "col": 3,
        "row": 4
      },
      "plane": "data"
    },
    {
      "id": "order-db",
      "label": "Order store",
      "sub": "Relational, replicated",
      "icons": [
        "database"
      ],
      "detail": {
        "role": "Orders, lines and state changes.",
        "why": "Money and legal records need transactions."
      },
      "layer": "data",
      "at": {
        "col": 3,
        "row": 5
      },
      "plane": "data",
      "lenses": {
        "security": {
          "badge": "Encrypted, backed up",
          "text": "Encrypted at rest with point-in-time recovery.",
          "level": "good"
        }
      }
    },
    {
      "id": "cache",
      "label": "Session and basket cache",
      "sub": "In memory",
      "icons": [
        "redis"
      ],
      "detail": {
        "role": "Holds sessions and baskets for fast reads.",
        "why": "Checkout latency stays low at peak."
      },
      "layer": "data",
      "at": {
        "col": 1,
        "row": 4
      },
      "plane": "data"
    },
    {
      "id": "search-idx",
      "label": "Search index",
      "sub": "Search cluster",
      "icons": [
        "search"
      ],
      "detail": {
        "role": "The searchable copy of the catalogue.",
        "why": "Keyword and facet queries return in milliseconds."
      },
      "layer": "data",
      "at": {
        "col": 5,
        "row": 4
      },
      "plane": "data"
    },
    {
      "id": "lake",
      "label": "Data lake",
      "sub": "Object storage",
      "icons": [
        "s3"
      ],
      "detail": {
        "role": "Raw and curated data from every system.",
        "why": "One place for analytics and model training."
      },
      "layer": "data",
      "at": {
        "col": 8,
        "row": 5
      },
      "plane": "data",
      "lenses": {
        "cost": {
          "badge": "Tiered storage",
          "text": "Old data moves to cheaper tiers automatically.",
          "level": "info"
        }
      }
    },
    {
      "id": "dwh",
      "label": "Warehouse",
      "sub": "Analytics SQL",
      "icons": [
        "database"
      ],
      "detail": {
        "role": "Modelled data for reporting.",
        "why": "Finance and merchandising use one set of numbers."
      },
      "layer": "data",
      "at": {
        "col": 7,
        "row": 4
      },
      "plane": "data"
    },
    {
      "id": "feature-store",
      "label": "Feature store",
      "sub": "Model inputs",
      "icons": [
        "database"
      ],
      "detail": {
        "role": "Per-shopper and per-product features, online and offline.",
        "why": "Training and serving use identical inputs."
      },
      "layer": "data",
      "at": {
        "col": 8,
        "row": 4
      },
      "plane": "data"
    },
    {
      "id": "psp",
      "label": "Payment provider",
      "sub": "Cards and wallets",
      "icons": [
        "internet"
      ],
      "detail": {
        "role": "Authorises and captures payments.",
        "why": "Specialists carry the card-network certification."
      },
      "layer": "ext",
      "at": {
        "col": 2,
        "row": 6
      }
    },
    {
      "id": "carriers",
      "label": "Carriers",
      "sub": "Courier APIs",
      "icons": [
        "internet"
      ],
      "detail": {
        "role": "Book shipments and return tracking events.",
        "why": "Delivery options come from several carriers."
      },
      "layer": "ext",
      "at": {
        "col": 7,
        "row": 6
      }
    },
    {
      "id": "marketplace",
      "label": "Marketplace sellers",
      "sub": "Partner catalogues",
      "icons": [
        "internet"
      ],
      "detail": {
        "role": "Third-party sellers list and fulfil through the platform.",
