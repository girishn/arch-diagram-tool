      "layer": "ops",
      "at": {
        "col": 3,
        "row": 8
      },
      "plane": "control",
      "lenses": {
        "security": {
          "badge": "Zero trust inside",
          "text": "Every call is mutually authenticated and checked against policy.",
          "level": "good"
        }
      }
    },
    {
      "id": "obs",
      "label": "Observability",
      "sub": "Metrics, logs, traces",
      "icons": [
        "observability"
      ],
      "detail": {
        "role": "Collects metrics, logs and traces from every service.",
